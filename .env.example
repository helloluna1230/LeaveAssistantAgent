# ==========================================================================
# Leave Assistant Agent - environment configuration (example)
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# Prefer Managed Identity / `az login` (AzureCliCredential) over API keys.
# ==========================================================================

# ---- Azure OpenAI / model ----
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_MODEL_DEPLOYMENT=gpt-5.6-luna

# ---- Foundry project & hosted agent ----
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL=gpt-5.6-luna
FOUNDRY_AGENT_NAME=leave-assistant
FOUNDRY_AGENT_VERSION=
DEMO_DEFAULT_USER=E1001

# Native Foundry Agent Service Memory preference backend.
FOUNDRY_MEMORY_STORE=leave-assistant-memory

# Foundry IQ knowledge base (created manually in the portal; see knowledge/README.md)
FOUNDRY_KNOWLEDGE_INDEX=hr-leave-policies-index

# ---- Tool wiring mode ----
# toolbox = governed Foundry Toolbox (default) | remote = direct HTTP MCP | local = in-process
MCP_MODE=toolbox

# ---- Platform-managed conversations ----
# true (default) = Foundry Responses store persists each turn and resolves
# previous_response_id server-side, scoped to the verified caller identity.
# Hosted deployments use the durable platform store; local runs use an in-process
# store (lost on restart). Set false to disable persistence.
RESPONSES_STORE=true
# Per-user conversation bookmark (last Responses pointer) for cross-device resume.
# File-backed by default; swap for a durable DB (e.g. Cosmos DB) in production.
# SESSION_STORE_PATH=agents/leave_assistant/.session_store.json

# ---- Foundry Toolbox (MCP_MODE=toolbox) ----
# Consumer endpoint printed by scripts/create_toolbox.py
TOOLBOX_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/leave-assistant-toolbox/mcp?api-version=v1
TOOLBOX_NAME=leave-assistant-toolbox
# Foundry connection id holding the HR MCP server credentials (used when building the toolbox)
MCP_CONNECTION_ID=
# Project connection name for the Foundry IQ / Azure AI Search index (used when building the toolbox)
AZURE_AI_SEARCH_CONNECTION_NAME=

# ---- Mock HR MCP server (hosted on Container App) ----
# Container App FQDN of the deployed MCP server; used by the toolbox and MCP_MODE=remote.
MCP_SERVER_ENDPOINT=https://<mcp-containerapp-fqdn>/mcp
MCP_API_KEY=

# ---- Observability ----
APPLICATIONINSIGHTS_CONNECTION_STRING=
ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=false
OTEL_SERVICE_NAME=leave-assistant


# ---- Harness limits ----
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=20
